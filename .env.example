# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password_here
DB_NAME=it_complaint_db

# Security & JWT Configuration
JWT_SECRET_KEY=generate_a_random_64_character_hex_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Server & Network Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ENVIRONMENT=production

# CORS Allowed Origins (Comma separated - add your domain/LAN IP)
ALLOWED_ORIGINS=http://localhost:3000,http://your-server-ip:3000,https://yourdomain.gov.lk

# Desktop Java App API Key
DESKTOP_API_KEY=generate_a_random_key_here

# Upload Restrictions
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp,pdf,doc,docx,xls,xlsx,txt
